# Public URL of the site (used in RSS, sitemap and Open Graph tags)
SITE_URL=http://localhost:3000

# Owner sign-in (no accounts): only this Gmail address can open /admin and upload projects.
OWNER_EMAIL=you@gmail.com

# OAuth client ID from Google Cloud Console (APIs & Services > Credentials >
# Create credentials > OAuth client ID > Web application). Add your site's URL,
# e.g. http://localhost:3000, under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# Long random string used to sign the owner session cookie and hash visitor ids.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Where the SQLite database lives (defaults to ./data/portfolio.db)
# DATABASE_PATH=./data/portfolio.db
