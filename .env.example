# Public URL of the site (used in RSS, sitemap and Open Graph tags)
SITE_URL=http://localhost:3000

# Password for the /admin dashboard. Leave empty to disable the dashboard.
ADMIN_PASSWORD=

# Long random string used to sign the admin session cookie and hash visitor ids.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Where the SQLite database lives (defaults to ./data/portfolio.db)
# DATABASE_PATH=./data/portfolio.db
